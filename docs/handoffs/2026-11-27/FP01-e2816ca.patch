--- /dev/null
+++ b/prototype/agent/model-settings.mjs
@@ -0,0 +1,63 @@
+import {readFileSync, mkdirSync, writeFileSync, renameSync} from 'node:fs';
+import {join} from 'node:path';
+import {homedir} from 'node:os';
+import {randomUUID} from 'node:crypto';
+
+const directory = join(homedir(), '.freightpilot');
+const file = join(directory, 'model.json');
+
+export function validate(config) {
+  let url;
+  try {url=new URL(config.baseUrl);} catch {throw Error('API 地址格式无效');}
+  const local = ['127.0.0.1','localhost','[::1]'].includes(url.hostname);
+  if (config.mode === 'local' && (!local || !['http:','https:'].includes(url.protocol)))
+    throw Error('Only a local model endpoint is supported in local mode');
+  if (!['local','external'].includes(config.mode) || (config.mode === 'external' && url.protocol !== 'https:'))
+    throw Error('外部模型需要 HTTPS 地址');
+  if (url.username || url.password || url.search || url.hash || !config.model?.trim())
+    throw Error('请填写模型 ID 和不含身份信息或查询参数的 API 地址');
+  return config;
+}
+export function settings() {
+  try { return validate(JSON.parse(readFileSync(file,'utf8'))); }
+  catch (error) { if (error.code !== 'ENOENT') throw error; }
+  return validate({mode:'local',baseUrl:process.env.FREIGHT_MODEL_URL || 'http://127.0.0.1:1234/v1',model:process.env.FREIGHT_MODEL || 'qwen3.5-9b-mlx'});
+}
+export function publicSettings({mode,baseUrl,model,apiKey}) {
+  return {mode,baseUrl,model,hasKey:Boolean(apiKey)};
+}
+export function formSettings({mode,baseUrl,model,apiKey='',clearKey=false}) {
+  const config=validate({mode,baseUrl,model,apiKey});
+  if (!apiKey && !clearKey) {
+    const previous=settings();
+    if(previous.mode===mode && previous.baseUrl===baseUrl)config.apiKey=previous.apiKey;
+  }
+  return config;
+}
+export function saveSettings(input) {
+  const config=formSettings(input);
+  mkdirSync(directory,{recursive:true,mode:0o700});
+  const temporary=file+'.'+randomUUID();
+  writeFileSync(temporary,JSON.stringify(config),{mode:0o600,flag:'wx'});
+  renameSync(temporary,file);
+  return publicSettings(config);
+}
+export async function requestModel(config, body, fetchImpl=fetch, timeout=90000) {
+  validate(config);
+  return fetchImpl(new URL('chat/completions',config.baseUrl.replace(/\/?$/,'/')),{
+    method:'POST',redirect:'error',signal:AbortSignal.timeout(timeout),
+    headers:{'Content-Type':'application/json',...(config.apiKey?{Authorization:'Bearer '+config.apiKey}:{})},
+    body:JSON.stringify({...body,model:config.model})
+  });
+}
+export async function probe(config) {
+  const messages=[{role:'user',content:'Call the ping tool.'}];
+  const basic=await requestModel(config,{messages:[{role:'user',content:'Reply OK'}],max_tokens:16},fetch,90000);
+  if(!basic.ok) throw Error('模型连接失败 HTTP '+basic.status);
+  if(!(await basic.json()).choices?.[0]?.message) throw Error('模型响应格式无效');
+  try {
+    const result=await requestModel(config,{messages,max_tokens:512,tools:[{type:'function',function:{name:'ping',description:'Connectivity check',parameters:{type:'object',properties:{}}}}]},fetch,90000);
+    const call=result.ok && (await result.json()).choices?.[0]?.message?.tool_calls?.[0]?.function;
+    return {connected:true,tools:call?.name==='ping' && JSON.parse(call.arguments)!=null};
+  } catch { return {connected:true,tools:false}; }
+}
